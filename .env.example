# Local development settings. Copy to `.env` and fill in the blanks.
# `.env` is ignored by git; never commit real values.

# Any SQLAlchemy URL. SQLite needs no setup.
COSMOS_DATABASE_URL=sqlite:///data/app.db

# Plain http on localhost. Leave this out anywhere real so cookies stay HTTPS-only.
COSMOS_COOKIE_SECURE=false

# AI summaries and the question box switch on when one of these keys is filled
# in, and stay off without one. If both are set, Anthropic is used.
#   Gemini has a free tier: https://aistudio.google.com/api-keys
#   Anthropic:              https://platform.claude.com
# Google may train on what the free tier is sent, so keep real client data out of it.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# To choose explicitly: anthropic, gemini, openai_compatible or none.
# COSMOS_LLM_PROVIDER=gemini
# The model to use. Leave unset for the provider's default.
# COSMOS_LLM_MODEL=gemini-3.8-flash
# Any other provider that speaks the OpenAI protocol (Groq, Cerebras, Mistral, OpenRouter):
# COSMOS_LLM_PROVIDER=openai_compatible
# COSMOS_LLM_BASE_URL=https://api.groq.com/openai/v1/
# COSMOS_LLM_API_KEY=
# COSMOS_LLM_MODEL=llama-3.3-70b-versatile

# The account `python -m cosmos.app seed-demo` creates. Pick a password of 12+ characters.
COSMOS_DEMO_EMAIL=demo@northwind.test
COSMOS_DEMO_PASSWORD=
