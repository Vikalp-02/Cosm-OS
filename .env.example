# Local development settings. Copy to `.env` and fill in the blanks.
# `.env` is ignored by git; never commit real values.

# Any SQLAlchemy URL. SQLite needs no setup.
COSMOS_DATABASE_URL=sqlite:///data/app.db

# Plain http on localhost. Leave this out anywhere real so cookies stay HTTPS-only.
COSMOS_COOKIE_SECURE=false

# The account `python -m cosmos.app seed-demo` creates. Pick a password of 12+ characters.
COSMOS_DEMO_EMAIL=demo@northwind.test
COSMOS_DEMO_PASSWORD=
